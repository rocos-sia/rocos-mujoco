  <asset>
    <mesh name="base_link" file="base_link.obj"/>
    <mesh name="link_1" file="link_1.obj"/>
    <mesh name="link_2" file="link_2.obj"/>
    <mesh name="link_3" file="link_3.obj"/>
    <mesh name="link_4" file="link_4.obj"/>
    <mesh name="link_5" file="link_5.obj"/>
