      <geom type="sphere" size="0.02" rgba="0 1 0 1"/>
    </body> -->
    <body name="green_balls" pos="0 0 0">   <!-- 父坐标系原点 -->
    <geom type="sphere" size="0.02" rgba="0 1 0 1" pos="-0.861 0.436 1.095"/>
