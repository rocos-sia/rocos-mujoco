    <body name="Robot" pos="-0.51 0.075 0">
      <geom type="mesh" rgba="0.7 0.8 1 1" mesh="base_link" contype="0" conaffinity="0" />
      <geom type="mesh" rgba="0.8 0.8 0.8 0.3" mesh="shell" contype="0" conaffinity="0"/>
      <geom type="mesh" rgba="1 1 1 1" mesh="base_link"/>
      <body name="link_1">
        <inertial pos="0.0256003 9.36366e-06 0.348207" quat="0.9985 2.25783e-05 -0.0547488 8.5377e-05" mass="0.712358" diaginertia="0.00447402 0.00382119 0.00117382"/>
        <joint name="joint_1" pos="0 0 0" axis="0 0 1" type="slide" range="0 0.2" damping="50"/>
        <geom type="mesh" rgba="1 1 1 1" mesh="link_1" contype="0" conaffinity="0"/>
        <body name="link_2" pos="0 0 0.57801">
