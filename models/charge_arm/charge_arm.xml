            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>


  <sensor>
    <!-- 3维力传感器：测量sensor_site处的力（x/y/z轴） -->
    <force name="force_sensor" site="ft_site"/>
    <!-- 3维力矩传感器：测量sensor_site处的力矩（x/y/z轴） -->
    <torque name="torque_sensor" site="ft_site" />
  </sensor>

  <actuator>
    <position joint="joint_1" kp="500" kv="20" ctrlrange="0.0 0.3"/>
    <!-- range matches joint range -->
    <!-- joint_2 to joint_7: hinge joints (rotational), position control with PD -->
    <position joint="joint_2" kp="500" kv="20" ctrlrange="-3.14 3.14"/>
    <position joint="joint_3" kp="500" kv="20" ctrlrange="-3.14 3.14"/>
    <position joint="joint_4" kp="500" kv="20" ctrlrange="-3.14 3.14"/>
    <position joint="joint_5" kp="500" kv="20" ctrlrange="-3.14 3.14"/>
    <position joint="joint_6" kp="500" kv="20" ctrlrange="-3.14 3.14"/>
    <position joint="joint_7" kp="500" kv="20" ctrlrange="-3.14 3.14"/>
