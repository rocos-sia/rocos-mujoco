<mujoco model="talon">
  <compiler angle="radian"/>
  <option gravity="0 0 0" timestep="0.001"/>

  <asset>
    <mesh name="base_link" file="base_link.STL"/>
    <mesh name="link_1" file="link_1.STL"/>
    <mesh name="link_2" file="link_2.STL"/>
    <mesh name="link_3" file="link_3.STL"/>
    <mesh name="link_4" file="link_4.STL"/>
    <mesh name="link_5" file="link_5.STL"/>
    <mesh name="link_6" file="link_6.STL"/>
    <mesh name="link_7" file="link_7.STL"/>
  </asset>

  <worldbody>
    <geom quat="0 0 0 1" type="mesh" rgba="1 1 1 1" mesh="base_link" contype="0" conaffinity="0"/>
    <body name="link_1" pos="0 0 0.348">
      <inertial pos="0 0.008 -0.071" quat="0.707018 -0.0112084 0.0112084 0.707018" mass="5.683" diaginertia="0.0750634 0.075 0.0119366"/>
      <joint name="joint_1" pos="0 0 0" axis="0 0 1" damping="50"/>
      <geom quat="0 0 0 1" type="mesh" rgba="1 1 1 1" mesh="link_1" contype="0" conaffinity="0"/>
      <body name="link_2" quat="0.707107 0.707107 0 0">
        <inertial pos="0 0.117 0.024" quat="0.715275 0.698843 0 0" mass="3.99" diaginertia="0.099 0.0960465 0.00995351"/>
        <joint name="joint_2" pos="0 0 0" axis="0 0 1" damping="50"/>
        <geom pos="0 0 0" quat="0 0 0 1" type="mesh" rgba="1 1 1 1" mesh="link_1" contype="0" conaffinity="0"/>
        <body name="link_3" pos="0 0.41 0" quat="0.707107 -0.707107 0 0">
          <inertial pos="0 0.009 -0.058" quat="0.48672 0.512936 -0.512936 0.48672" mass="3.685" diaginertia="0.0400525 0.034 0.0209475"/>
          <joint name="joint_3" pos="0 0 0" axis="0 0 1" damping="50"/>
          <geom quat="0 0 0 1" type="mesh" rgba="1 1 1 1" mesh="link_3" contype="0" conaffinity="0"/>
          <body name="link_4" quat="0.707107 0.707107 0 0">
            <inertial pos="0 0.136 0.016" quat="0.711624 0.702561 0 0" mass="3.185" diaginertia="0.085 0.0840128 0.00598718"/>
            <joint name="joint_4" pos="0 0 0" axis="0 0 1" damping="50"/>
            <geom pos="0 0 0" quat="0 0 0 1" type="mesh" rgba="1 1 1 1" mesh="link_4" contype="0" conaffinity="0"/>
            <body name="link_5" pos="0 0.401 0" quat="0.707107 -0.707107 0 0">
              <inertial pos="0 0.008 -0.071" quat="0.985566 -0.0088915 -0.0547919 -0.159935" mass="2.932" diaginertia="0.0323527 0.032 0.0036473"/>
              <joint name="joint_5" pos="0 0 0" axis="0 0 1" damping="50"/>
              <geom quat="0 0 0 1" type="mesh" rgba="1 1 1 1" mesh="link_5" contype="0" conaffinity="0"/>
              <body name="link_6" quat="0.707107 0.707107 0 0">
                <inertial pos="0 0.089 0.018" quat="0.721077 0.692855 0 0" mass="2.043" diaginertia="0.029 0.0280399 0.00296006"/>
                <joint name="joint_6" pos="0 0 0" axis="0 0 1" damping="50"/>
                <geom pos="0 0 0" quat="0 0 0 1" type="mesh" rgba="1 1 1 1" mesh="link_6" contype="0" conaffinity="0"/>
                <body name="link_7" pos="0 0.23 0" quat="0.707107 -0.707107 0 0">
                  <inertial pos="0 0 -0.032" mass="0.994" diaginertia="0.002 0.002 0.001"/>
                  <joint name="joint_7" pos="0 0 0" axis="0 0 1" damping="50"/>
                  <geom type="mesh" rgba="1 1 1 1" mesh="link_7" contype="0" conaffinity="0"/>
                  <site name="ft_site" pos="0 0 0" quat="1 0 0 0" type="sphere" size="0.01"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <sensor>
    <!-- 3维力传感器 -->
    <force name="force_sensor" site="ft_site"/>
    <!-- 3维力矩传感器 -->
    <torque name="torque_sensor" site="ft_site"/>
  </sensor>

  <actuator>
    <!-- joint_1 到 joint_7: 转动关节，位置控制带 PD -->
    <position joint="joint_1" kp="500" kv="20" ctrlrange="-3.14 3.14"/>
    <position joint="joint_2" kp="500" kv="20" ctrlrange="-3.14 3.14"/>
    <position joint="joint_3" kp="500" kv="20" ctrlrange="-3.14 3.14"/>
    <position joint="joint_4" kp="500" kv="20" ctrlrange="-3.14 3.14"/>
    <position joint="joint_5" kp="500" kv="20" ctrlrange="-3.14 3.14"/>
    <position joint="joint_6" kp="500" kv="20" ctrlrange="-3.14 3.14"/>
    <position joint="joint_7" kp="500" kv="20" ctrlrange="-3.14 3.14"/>
  </actuator>
</mujoco>
