<!--
  MuJoCo scene for the rocos-mujoco simulator.
  This file wraps the URDF robot model and sets simulation defaults.
-->
<mujoco model="rocos_sim">
  <compiler
    angle="radian"
    meshdir="meshes"
    autolimits="true"
    balanceinertia="true"
  />

  <option
    timestep="0.001"
    gravity="0 0 -9.81"
    integrator="implicitfast"
    cone="elliptic"
  />

  <!-- Default solver settings for articulated robots -->
  <size
    njmax="500"
    nconmax="500"
    nstack="500000"
  />

  <visual>
    <map stiffness="1000" />
  </visual>

  <!-- Ground plane for visualization -->
  <worldbody>
    <light name="light1" pos="2 2 3" dir="-1 -1 -2" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="2 2 0.01" rgba="0.3 0.3 0.3 1"/>
  </worldbody>

  <!-- Include the robot URDF -->
  <include file="robot.urdf"/>

</mujoco>
